<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Wanderlust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/style.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand bg-white border-bottom sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-danger" href="/listings">Wanderlust</a>
      <form class="d-flex mx-auto" action="/listings" method="GET">
        <input class="form-control me-2" name="q" placeholder="Search destinations" />
        <button class="btn btn-danger">Search</button>
      </form>
      <div class="d-flex gap-3 align-items-center">
        <% if (currUser) { %>
          <a href="/listings/new">Add listing</a>
          <a href="/bookings">My bookings</a>
          <form action="/logout" method="POST" class="m-0"><button class="btn btn-sm btn-outline-dark">Logout (<%= currUser.username %>)</button></form>
        <% } else { %>
          <a href="/signup">Sign up</a>
          <a href="/login">Log in</a>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container mt-3">
    <% if (success && success.length) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error && error.length) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <%- body %>
  </div>
  <footer class="text-center text-muted py-4 mt-5 border-top">Wanderlust &copy; <%= new Date().getFullYear() %></footer>
</body>
</html>
